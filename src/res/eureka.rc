// Menu, accelerators and the dialog templates.  Kept declarative and in one
// file on purpose: this is the layout, and a layout expressed in dialog units
// scales with the dialog font instead of being computed by us.
//
// The strings here are Slovak and the file is UTF-8, so windres is called with
// --codepage=65001 (see the Makefile).  Resources hold UTF-16 either way.

#include <windows.h>
#include "resource.h"

#pragma code_page(65001)

// The manifest asks for Common Controls 6 and system DPI awareness.
1 RT_MANIFEST "eureka.manifest"

/////////////////////////////////////////////////////////////////////////////
// Menu
//
// Every command that has a shortcut names it after the tab, because that is
// where a screen reader looks for it.  A shortcut nobody can discover is a
// shortcut nobody has.

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&Súbor"
    BEGIN
        MENUITEM "S&končiť\tF11, Ctrl+Q",                       ID_FILE_EXIT
    END
    POPUP "&Disketa"
    BEGIN
        MENUITEM "&Vložiť disketu z priečinka…\tF11, Ctrl+I",   ID_DISK_INSERT
        MENUITEM "Vložiť &novú disketu…\tF11, Ctrl+M",          ID_DISK_NEW
        MENUITEM "V&ysunúť disketu\tF11, Ctrl+0",               ID_DISK_EJECT
        MENUITEM "&Zamknúť proti zápisu\tF11, Ctrl+Z",          ID_DISK_PROTECT
        MENUITEM SEPARATOR
        MENUITEM "&Uložiť disketu do priečinka…\tF11, Ctrl+U",  ID_FILE_EXPORT
        MENUITEM SEPARATOR
        /* The nine slots.  Their text is rewritten at every WM_INITMENUPOPUP
           from the settings file -- what stands here is only what an empty one
           says, and the mnemonic, which is the slot number itself. */
        MENUITEM "&1 (prázdny)\tF11, Ctrl+1",                   ID_DISK_SLOT1
        MENUITEM "&2 (prázdny)\tF11, Ctrl+2",                   ID_DISK_SLOT2
        MENUITEM "&3 (prázdny)\tF11, Ctrl+3",                   ID_DISK_SLOT3
        MENUITEM "&4 (prázdny)\tF11, Ctrl+4",                   ID_DISK_SLOT4
        MENUITEM "&5 (prázdny)\tF11, Ctrl+5",                   ID_DISK_SLOT5
        MENUITEM "&6 (prázdny)\tF11, Ctrl+6",                   ID_DISK_SLOT6
        MENUITEM "&7 (prázdny)\tF11, Ctrl+7",                   ID_DISK_SLOT7
        MENUITEM "&8 (prázdny)\tF11, Ctrl+8",                   ID_DISK_SLOT8
        MENUITEM "&9 (prázdny)\tF11, Ctrl+9",                   ID_DISK_SLOT9
        MENUITEM SEPARATOR
        MENUITEM "&Spravovať sloty…",                           ID_DISK_SLOTS
    END
    POPUP "&Stroj"
    BEGIN
        MENUITEM "&Reset\tF11, Ctrl+R",                         ID_MACHINE_RESET
        MENUITEM "&Vypnúť Eureku\tF11, Ctrl+V",                 ID_MACHINE_POWEROFF
    END
    POPUP "&Klávesnica"
    BEGIN
        MENUITEM "&Braillovská",                                ID_KEYBOARD_BRAILLE
        MENUITEM "&Externá",                                    ID_KEYBOARD_PC
        MENUITEM SEPARATOR
        MENUITEM "&Prepnúť\tF11, Ctrl+K",                       ID_KEYBOARD_TOGGLE
        MENUITEM SEPARATOR
        MENUITEM "&Uvoľniť klávesnicu\tShift+F11",              ID_KEYBOARD_RELEASE
        MENUITEM "&Jeden kláves do Windows alebo skratka\tF11",  ID_KEYBOARD_PASSONCE
        MENUITEM SEPARATOR
        POPUP "P&oslať Eureke kláves"
        BEGIN
            MENUITEM "&F11",                                    ID_KEYBOARD_SEND_F11
            MENUITEM "&Alt+F11",                                ID_KEYBOARD_SEND_AF11
            MENUITEM "F&12",                                    ID_KEYBOARD_SEND_F12
            MENUITEM "A&lt+F12",                                ID_KEYBOARD_SEND_AF12
        END
    END
    POPUP "&Nástroje"
    BEGIN
        MENUITEM "&Nastavenia…\tF11, Ctrl+N",                   ID_TOOLS_SETTINGS
        MENUITEM "&Výpis diagnostiky\tF11, Ctrl+D",             ID_TOOLS_DIAGDUMP
    END
    POPUP "&Pomocník"
    BEGIN
        MENUITEM "&Klávesové skratky…\tF11, Ctrl+H",            ID_HELP_KEYS
        MENUITEM "&O programe…",                                ID_HELP_ABOUT
    END
END

/////////////////////////////////////////////////////////////////////////////
// Accelerators
//
// Two tables, because a host shortcut is not free: TranslateAccelerator eats
// the press before the window sees it, so anything named here is a key the
// guest can never receive.  Splitting them lets all but three be conditional.
//
// IDR_ACCELERATORS is always in force and is the whole permanent cost.  F12
// opens the menu bar, because the two keys Windows would normally use for it
// are the guest's: Alt is a modifier on the braille keyboard and F10 is the
// Eureka's own "where am I".
//
// F11 and F12 are *not* free either, which this table used to claim on the
// strength of KB.H stopping at K_F10.  The ROM's own table for the PC keyboard
// goes further: scan code 57h maps to CAh and 58h to CBh (1DF05), so with the
// Alt bit those are the Eureka's Alt+F11, "data ROM", and Alt+F12, which its
// help calls unused.  These three cost the least of what was on offer, and the
// Keyboard menu hands both keys back on demand.

IDR_ACCELERATORS ACCELERATORS
BEGIN
    VK_F11,     ID_KEYBOARD_PASSONCE, VIRTKEY
    VK_F11,     ID_KEYBOARD_RELEASE,  VIRTKEY, SHIFT
    VK_F12,     ID_ACTIVATE_MENU,     VIRTKEY
END

// IDR_ACCELERATORS_HOST is in force only while the keyboard is the host's:
// after F11 (one key to Windows) or Shift+F11 (let go of it altogether).  The
// rest of the time Ctrl+K, Ctrl+H and the others reach Eureka untouched, which
// is the point -- the ROM's decoder folds Ctrl+letter into a control character
// with AND 1Fh (1DE0E), and taking eight of those away from the guest bought
// nothing that F11 does not buy.
//
// Ctrl+letter and not Ctrl+Shift+letter, even so.  Ctrl+Shift is where other
// programs put their *global* hotkeys, and a global hotkey (RegisterHotKey)
// beats an accelerator table whatever gates it -- the press never reaches the
// window at all, and the failure is silent.  It had already happened on the
// owner's machine: an organiser held Ctrl+Shift+H and Ctrl+Shift+R, so Help
// and Reset did nothing.  Measured with RegisterHotKey on 28. 8. 2026: all
// eight of these are free there, and the probe rang on those two.
//
// Whoever adds an entry here: the window never sees the press, so it cannot
// spend the one-shot on it.  MainWindow's WM_COMMAND does that instead, and
// without it F11 would stay armed for good -- silently.

IDR_ACCELERATORS_HOST ACCELERATORS
BEGIN
    "U",        ID_FILE_EXPORT,      VIRTKEY, CONTROL
    "I",        ID_DISK_INSERT,      VIRTKEY, CONTROL
    "M",        ID_DISK_NEW,         VIRTKEY, CONTROL
    "Q",        ID_FILE_EXIT,        VIRTKEY, CONTROL
    "R",        ID_MACHINE_RESET,    VIRTKEY, CONTROL
    "V",        ID_MACHINE_POWEROFF, VIRTKEY, CONTROL
    "K",        ID_KEYBOARD_TOGGLE,  VIRTKEY, CONTROL
    "N",        ID_TOOLS_SETTINGS,   VIRTKEY, CONTROL
    "D",        ID_TOOLS_DIAGDUMP,   VIRTKEY, CONTROL
    "H",        ID_HELP_KEYS,        VIRTKEY, CONTROL
    "Z",        ID_DISK_PROTECT,     VIRTKEY, CONTROL
    /* The quick choice.  Nine keys look expensive and cost nothing: they are
       in this table, so they apply only once the keyboard is the host's, and
       Eureka never loses a single one of them.  Ctrl+0 ejects, which puts
       "no diskette" in the same row as the nine that put one in. */
    "0",        ID_DISK_EJECT,       VIRTKEY, CONTROL
    "1",        ID_DISK_SLOT1,       VIRTKEY, CONTROL
    "2",        ID_DISK_SLOT2,       VIRTKEY, CONTROL
    "3",        ID_DISK_SLOT3,       VIRTKEY, CONTROL
    "4",        ID_DISK_SLOT4,       VIRTKEY, CONTROL
    "5",        ID_DISK_SLOT5,       VIRTKEY, CONTROL
    "6",        ID_DISK_SLOT6,       VIRTKEY, CONTROL
    "7",        ID_DISK_SLOT7,       VIRTKEY, CONTROL
    "8",        ID_DISK_SLOT8,       VIRTKEY, CONTROL
    "9",        ID_DISK_SLOT9,       VIRTKEY, CONTROL
END

/////////////////////////////////////////////////////////////////////////////
// Settings
//
// Deliberately thin.  It holds the two switches that already exist and mean
// something at runtime; what else becomes a setting, and what survives between
// runs, is the same question as keeping the RAM across runs and is decided
// with it (HANDOFF 6.15, 6.18).

IDD_SETTINGS DIALOGEX 0, 0, 232, 132
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Nastavenia"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Klávesnica", IDC_STATIC, 7, 7, 218, 52
    CONTROL         "&Braillovská (body F D S J K L, píše sa akordmi)",
                    IDC_MODE_BRAILLE, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,
                    16, 21, 200, 12
    CONTROL         "&Externá (píše sa písmenami, rozloženie je české)",
                    IDC_MODE_PC, "Button", BS_AUTORADIOBUTTON,
                    16, 38, 200, 12

    // WS_GROUP here and not for decoration: a radio group runs from the
    // control that carries WS_GROUP up to the *next* one that carries it, and
    // without this the group ran on into the group box.  Arrow keys then died
    // on it -- Down from "Externá" stayed put and Up from "Braillovská" did
    // nothing at all, because the wrap landed on a control that cannot take
    // focus.  Measured on the built EXE through IsDialogMessage.  The same
    // three radios in IDD_NEWDISK cycle only because an LTEXT follows them and
    // windres gives LTEXT WS_GROUP by default; nothing here follows that rule.
    GROUPBOX        "Diagnostika", IDC_STATIC, 7, 65, 218, 40,
                    BS_GROUPBOX | WS_GROUP
    CONTROL         "&Zapnutá — záznam na konzolu, výpis v ponuke Nástroje",
                    IDC_DIAGNOSTICS, "Button", BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,
                    16, 79, 200, 12

    DEFPUSHBUTTON   "OK", IDOK, 118, 111, 50, 14, WS_GROUP
    PUSHBUTTON      "Zrušiť", IDCANCEL, 175, 111, 50, 14
END

/////////////////////////////////////////////////////////////////////////////
// About
//
// The body is a read-only multiline edit rather than static text, so a screen
// reader can walk it with the review cursor instead of having to take it in
// one announcement.  It is a tab stop for the same reason.

/////////////////////////////////////////////////////////////////////////////
// New diskette
//
// One dialog and not a wizard.  Three choices fit on one page, and one page is
// one role, one tab order and one Enter for a screen reader to deal with,
// where a property sheet would be three of each.
//
// Only kinds that make a diskette.  There was a fourth radio here, "from an
// existing folder", and it was the same act as Disketa -> Vložiť disketu z
// priečinka down to the identical PostMountDisk call -- one deed under two
// names, in a dialog whose own caption then contradicted it.  Putting an
// existing diskette in is Ctrl+I; this dialog makes new ones.
//
// The radios name what the user is choosing between, which is whether the
// diskette already has a folder.  "Nový prázdny priečinok" named the mechanism
// instead, and a folder is not a thing beside a diskette -- it is what a saved
// diskette is made of.
//
// "Uložená" and "neuložená" and not "trvalá" and "dočasná v pamäti", which is
// what they said before 6.28.  Every diskette lives in memory -- mounting a
// folder reads it into an image -- so "v pamäti" named nothing; and "dočasná"
// called the outcome settled when Ctrl+U is exactly what unsettles it.  The
// second radio therefore says where the folder comes from rather than
// promising a loss: an earlier wording, "zanikne s emulátorom", stated flat a
// loss the program in fact prevents, and a label that overstates once is a
// label nobody believes the next time.

IDD_NEWDISK DIALOGEX 0, 0, 292, 164
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Nová disketa"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Aká disketa", IDC_STATIC, 7, 7, 278, 64
    /* Mnemoniky O, N, F a nie U, N, N.  "Uložená" a "Uložiť do slotu" nižšie
       si obe pýtali Alt+U a obe "neuložené" prepínače Alt+N -- po premenovaní
       v 6.28, ktoré ich dovtedy malo na T, D a N.  Alt+U zostáva výberu slotu,
       lebo ten sa nemenil; prepínače dostali písmená, ktoré sú v tomto
       dialógu voľné.  Overuje sa to na hotovom EXE, nie tu -- viď 6.28. */
    CONTROL         "Ul&ožená — nový priečinok, prežije aj ukončenie emulátora",
                    IDC_NEW_EMPTYFOLDER, "Button",
                    BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 16, 20, 260, 12
    CONTROL         "&Neuložená — priečinok jej dáte až Ctrl+U, dovtedy žije "
                    "len tu",
                    IDC_NEW_UNSAVED, "Button", BS_AUTORADIOBUTTON, 16, 34, 260, 12
    CONTROL         "Neuložená a nena&formátovaná — Eureka ju ohlási "
                    "ako vadný disk", IDC_NEW_UNFORMATTED, "Button",
                    BS_AUTORADIOBUTTON, 16, 48, 260, 12

    LTEXT           "&Priečinok:", IDC_STATIC, 7, 81, 40, 9
    EDITTEXT        IDC_NEW_PATH, 50, 79, 176, 14, ES_AUTOHSCROLL | WS_GROUP |
                    WS_TABSTOP
    PUSHBUTTON      "P&rehľadávať…", IDC_NEW_BROWSE, 232, 79, 53, 14

    LTEXT           "&Uložiť do slotu:", IDC_STATIC, 7, 103, 60, 9
    COMBOBOX        IDC_NEW_SLOT, 70, 101, 215, 100,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_GROUP | WS_TABSTOP

    DEFPUSHBUTTON   "OK", IDOK, 178, 143, 50, 14, WS_GROUP
    PUSHBUTTON      "Zrušiť", IDCANCEL, 235, 143, 50, 14
END

/////////////////////////////////////////////////////////////////////////////
// Slots
//
// "Slot" and nothing else.  This was "rýchla voľba" in the menu and in the
// caption while the very same thing was a numbered "slot" in the list, in the
// settings file and in the shortcut help -- two names for one place, which is
// one name too many in a menu the user is already navigating by ear.
//
// A listbox and three buttons, and no coordinates computed anywhere: nine
// slots always fit, so there is nothing to lay out at run time.  The list
// carries the slot number at the front of every line, because that number is
// the shortcut -- a screen reader reading "3: Slovník" has said which key
// puts it in.

// Four buttons and not three, because a slot holds exactly two things -- a
// path, or the *pamat marker -- and only one of them could be put here.  The
// marker got in solely through "Sem vloženú disketu", so a slot for a diskette
// in memory could not be set up unless one happened to be in the drive.
//
// Deliberately not the "Nová disketa" dialog reused: it offers three kinds, of
// which a slot can hold two -- unformatted is barred by the rule that a slot
// must not name a state that ends at the first Shift+F8, and the new-folder
// kind already assigns a slot from its own combo.  A shared dialog would put
// two dead ends in front of a two-way question.
//
// The buttons read in tab order down the pairs, which is the order a screen
// reader walks them: point the slot somewhere, or fill it from the drive; then
// make it a memory slot, or empty it.

IDD_SLOTS DIALOGEX 0, 0, 300, 190
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sloty s disketami"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Sloty — vkladá ich F11 a číslo s Ctrl:", IDC_STATIC,
                    7, 7, 286, 9
    LISTBOX         IDC_SLOT_LIST, 7, 19, 286, 90,
                    LBS_NOTIFY | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    /* WS_GROUP on the first button and on the check box below, for the same
       reason as in IDD_SETTINGS: without them the list box, all four buttons
       and the check box were one arrow group, so an arrow key on a button
       walked through the other buttons, then through the lock, and finally
       into the list -- where it also changed the selected slot.  Now the
       buttons cycle among themselves and the lock stands alone. */
    PUSHBUTTON      "&Priradiť priečinok…", IDC_SLOT_ASSIGN, 7, 115, 138, 14,
                    WS_GROUP
    PUSHBUTTON      "Sem &vloženú disketu", IDC_SLOT_CURRENT, 155, 115, 138, 14
    PUSHBUTTON      "Sem &novú neuloženú", IDC_SLOT_NEWUNSAVED, 7, 133, 138, 14
    /* "Vyprázdniť s&lot" and not "&Vyprázdniť": V and the v of "Sem vloženú"
       are the same mnemonic to Windows, so Alt+V cycled between two buttons
       instead of pressing one.  It was that way before this row existed. */
    PUSHBUTTON      "Vyprázdniť s&lot", IDC_SLOT_CLEAR, 155, 133, 138, 14
    AUTOCHECKBOX    "&Zamknúť túto disketu proti zápisu", IDC_SLOT_LOCK,
                    7, 155, 286, 10, BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 186, 169, 50, 14, WS_GROUP
    PUSHBUTTON      "Zrušiť", IDCANCEL, 243, 169, 50, 14
END

IDD_ABOUT DIALOGEX 0, 0, 268, 156
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "O programe"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_ABOUT_TEXT, 7, 7, 254, 121,
                    ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL |
                    WS_GROUP | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 211, 134, 50, 14, WS_GROUP
END
